<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>ja</string>
	<key>CFBundleDisplayName</key>
        <string>たびのしおり</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- 「非適用(non-exempt)の暗号化は使っていない」の申告。
	     本アプリは外部と通信しないため false。
	     独自の暗号実装を積んだら申告し直すこと -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!--
	  しおりファイル(.tabishiori)を受け取れるようにする。
	  これが無いと、LINE や AirDrop で送られたファイルの「共有」に
	  たびのしおり が出てこない ── 共有機能そのものが片道になる。

	  UTExportedTypeDeclarations: この形式は自分たちが定義したものだと宣言する
	  CFBundleDocumentTypes:      その形式を開けるアプリだと宣言する

	  中身は JSON なので public.json に適合させる。
	  自分の形式(.tabishiori)だけ LSHandlerRank = Owner。
	  あとから足した public.json は Apple の型なので Alternate にしてある。
	-->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.tsukune.travelnote.shiori</string>
			<key>UTTypeDescription</key>
			<string>たびのしおり</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>tabishiori</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/json</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>たびのしおり</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.tsukune.travelnote.shiori</string>
			</array>
		</dict>
		<!--
		  書き出しは `.json` にした ── **LINE が独自拡張子のファイルを送れず、
		  共有の主経路が塞がっていた**(実機で確認)。詳細は
		  src/share/snapshot.ts の snapshotFileName。

		  `public.json` は Apple の型なので Owner を名乗らない。
		  **Alternate** にして、JSON を扱う他のアプリの邪魔をしない
		  (共有シートには出るが、既定にはならない)。
		  しおりでない JSON を開かれても parseSnapshot が弾く。
		-->
		<dict>
			<key>CFBundleTypeName</key>
			<string>しおりのファイル (JSON)</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.json</string>
			</array>
		</dict>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
    <false/>
    <key>UISceneConfigurations</key>
    <dict>
      <key>UIWindowSceneSessionRoleApplication</key>
      <array>
        <dict>
            <key>UISceneConfigurationName</key>
            <string>Default Configuration</string>
            <key>UISceneDelegateClassName</key>
            <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
            <key>UISceneStoryboardFile</key>
            <string>Main</string>
        </dict>
      </array>
    </dict>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!--
		CloudKit の共有リンクをこのアプリで開く(ROADMAP E-0)。

		⚠️ **これが無いと、共有リンクをタップしても Safari が
		iCloud のページを開くだけ**で、SceneDelegate の
		`userDidAcceptCloudKitShareWith` は一度も呼ばれない。
		「受け取りが動かない」の原因になりやすい1行。
	-->
	<key>CKSharingSupported</key>
	<true/>
</dict>
</plist>
