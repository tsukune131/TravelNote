<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		共有拡張と本体で1つの入れ物を共有する。
		拡張は別プロセスなので、これが無いと受け取ったリンクを本体へ渡せない。

		⚠️ Capability の追加なので、Apple Developer ポータルで
		この App Group を作り、両方の App ID で有効にしてから
		lane=refresh_profiles を回すこと(手順は docs/ios-release-setup.md)。
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.tsukune.travelnote</string>
	</array>

	<!--
		CloudKit(ROADMAP E-0)。**旅程は利用者自身の iCloud に置かれ、
		開発者はアクセスできない** ── これが「データを収集していません」を
		維持したまま共有を作れる根拠。

		⚠️ 拡張(ShareExtension)には付けない。共有拡張は CloudKit を触らない。
		⚠️ App Group と同じく Capability の追加なので、
		   ポータルでコンテナを作る → App ID で iCloud を有効にする →
		   lane=refresh_profiles、の順が要る(docs/ios-release-setup.md §7.7)。
		   certificates では足りない(force が無く既存プロファイルを作り直さない)
	-->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.tsukune.travelnote</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
</dict>
</plist>
